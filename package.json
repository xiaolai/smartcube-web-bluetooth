{
  "name": "smartcube-web-bluetooth",
  "version": "4.0.0",
  "description": "Library for interaction with multiple vendor Smart Cubes and Timers using Web Bluetooth API (hardened fork of poliva/smartcube-web-bluetooth)",
  "private": false,
  "types": "./dist/types/index.d.ts",
  "module": "./dist/esm/index.mjs",
  "main": "./dist/cjs/index.cjs",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.mjs",
      "require": "./dist/cjs/index.cjs",
      "default": "./dist/esm/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "rm -rf dist/",
    "compile:bundles": "rollup -c",
    "check:dist": "node scripts/check-dist.mjs",
    "lint": "eslint src",
    "compile:types": "tsc -p tsconfig.types.json",
    "build": "npm run clean && npm run compile:types && npm run compile:bundles && npm run check:dist",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "keywords": [
    "GAN",
    "GANCUBE",
    "Giiker",
    "GoCube",
    "MoYu",
    "QiYi",
    "Timer",
    "GAN Smart Timer",
    "GAN Smart Cube",
    "Smart Timer",
    "Smart Cube",
    "Bluetooth",
    "Web Bluetooth",
    "Cubing",
    "Speedcubing",
    "Rubik's Cube"
  ],
  "author": "Andy Fedotov and Pau Oliva",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaolai/smartcube-web-bluetooth.git"
  },
  "dependencies": {
    "@types/web-bluetooth": "^0.0.20",
    "aes-js": "^3.1.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "^11.1.6",
    "@types/aes-js": "^3.1.4",
    "@types/node": "^22.19.15",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^10.9.1",
    "happy-dom": "^20.12.0",
    "rollup": "^4.60.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^3.2.4",
    "vitest-mock-extended": "^2.0.2"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/test",
    "!src/**/__snapshots__",
    "README.md",
    "LICENSE.txt",
    "package.json"
  ]
}
